# Copy to .env or export in your shell. Every setting in config/organism.toml can be
# overridden with ORGANISM_<SECTION>__<KEY>, e.g. ORGANISM_LLM__PROVIDER=rule
ORGANISM_LLM__PROVIDER=auto
ORGANISM_LLM__OLLAMA_MODEL=qwen3.5:4b
# Optional cloud language back-end. Never exposed to cognitive prompts or logs.
# ANTHROPIC_API_KEY=
# Optional web search for the research agent (https://tavily.com). Never exposed to prompts or logs.
# TAVILY_API_KEY=
# Let the cortex look facts up online (Wikipedia; Tavily if the key above is set):
# ORGANISM_SAFETY__PERMISSIONS={"digital_write": false, "internet_read": true}
ORGANISM_VISION__ENABLED=false
ORGANISM_AUDIO__MICROPHONE=false
